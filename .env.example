# Copy to .env and fill in. Never commit .env.
# Lines starting with # are optional; the value shown is the default.

# Perceptron. Brandon has the key and posts it in the chat.
# Team key for the Robotics API (datasets, training, deployments)
PERCEPTRON_TEAM_API_KEY=
# Vision API key (may be the same key)
PERCEPTRON_API_KEY=
# Deployment id printed by `python -m arm.train` after a fine-tuning run (needed for --real-arm)
PERCEPTRON_DEPLOYMENT_ID=

# Gemini (voice/)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_MS=1500
# Full Flash model (tested at 2.8 s a parse): GEMINI_MODEL=gemini-3.8-flash GEMINI_TIMEOUT_MS=8000 GEMINI_THINKING_LEVEL=low GEMINI_MAX_OUTPUT_TOKENS=1024

# ElevenLabs. cd voice && npm run agent -- https://<tunnel> creates the agent and writes ELEVENLABS_AGENT_ID
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shared secret the ElevenLabs agent sends as Bearer to voice/'s /v1/chat/completions. Empty = no check (npm run agent makes one)
VOICE_LLM_SECRET=

# Photon (voice/: end-of-case text)
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Phone number for the summary when the call has no caller id, e.g. +12065550100
PHOTON_SUMMARY_TO=
# The Photon line to call and text (written by cd voice && npm run photon -- setup +1...), shown by run_all
PHOTON_LINE=
# Spectrum project (stable Photon docs). voice/ uses these when PHOTON_* are empty
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Public dashboard URL (not a secret). Set it and a "Case replay: <url>/case.html?id=<case_id>" text follows the summary
# SCRUB_PUBLIC_URL=https://scrub.example.com

# MongoDB Atlas (ledger/)
MONGODB_URI=

# Hugging Face (LeRobot datasets)
HF_TOKEN=

# Real arm (arm/real_arm.py, read by `python -m controller --real-arm`)
SO101_PORT=
# SO101_ROBOT_ID=scrub_follower
# SO101_SIDE_CAMERA=0
# SO101_WRIST_CAMERA=1

# Controller tuning. Measure on the real arm before changing:
# load change (raw Present_Load, either sign) that counts as the clinician pulling
# PULL_LOAD_DELTA=80
# gripper fraction (0 open, 1 closed) at or above which a pick closed on nothing; lower for thin items
# GRIPPER_CLOSED=0.95
# share of the held grip load at or under which the gripper lets go (0 = off)
# PULL_COLLAPSE_FRAC=0.3
# seconds before a tray read counts as no camera reading; keep above the Perceptron detect time
# TRAY_STALE_S=8
# closed-hand posts in a row that freeze the approach (0 = off)
# HAND_CLOSED_READS=3

# Vision (vision/)
CAMERA_INDEX=0
# fixed exposure and white balance (camera units); unset = the vision default
# CAMERA_EXPOSURE=-6
# CAMERA_WB=
# VISION_PORT=8001
# VISION_SETTING=surgical
# 1 = fake camera, no hardware
# VISION_FAKE=0
# saved hand height to use (vision/hand_heights.json)
# CLINICIAN=
# VISION_EXTRA_CATEGORIES=1
# Perceptron detect: timeout, upload width in px (0 = full frame), and when a tray read counts as stale
# VISION_DETECT_TIMEOUT_S=6
# VISION_DETECT_WIDTH=640
# VISION_TRAY_STALE_S=8
# 127.0.0.1 keeps the camera stream on this laptop; 0.0.0.0 opens it to the LAN (a second device showing the stream)
# VISION_HOST=127.0.0.1

# Local wiring
CONTROLLER_URL=http://localhost:8000
VISION_URL=http://localhost:8001
VOICE_PORT=3000
# VOICE_HOLD_S=8
# ElevenLabs voice for the arm speaking in the room (explore/arm_voice.py); default Sarah. SCRUB_VOICE=off silences it
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
